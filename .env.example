# Substacker configuration.
# Copy to .env and edit. Never commit .env; it is excluded by .gitignore.

# --- Application and security -------------------------------------------------
# Required. Signs sessions and tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
SESSION_TIMEOUT=3600
CSRF_ENABLED=true
BASE_URL=http://localhost:8000
# Set to "production" to enable stricter cookie and CSRF handling.
ENVIRONMENT=development

# --- Database -----------------------------------------------------------------
# "sqlite" requires no setup and is the default for local development.
# "supabase" requires SUPABASE_URL and SUPABASE_KEY below.
DATABASE_TYPE=sqlite

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your-supabase-service-key

# --- Email (optional) ---------------------------------------------------------
# Email delivery is disabled when these are unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Substacker
ADMIN_EMAIL=

# --- Provider API keys (optional) ---------------------------------------------
# Only needed to pull usage directly from a provider.
# CSV import and SDK tracking do not require these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Upload limits ------------------------------------------------------------
MAX_FILE_SIZE=10485760
MAX_FILE_ROWS=10000
